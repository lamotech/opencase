{
	"name": "nextcloud/opencase",
	"description": "Open source case and content management system to Danish municipalities. Featuring integrations to Joint Municipal Infrastructure: Access control, Organisation, Classification, Person CPR query, Company CVR query, Sending and receiving digital mail",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Lamotech Solutions ApS",
			"email": "dev@lamotech.dk",
			"homepage": "https://lamotech.dk"
		}
	],
	"autoload": {
		"psr-4": {
			"OCA\\OpenCase\\": "lib/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test:unit": "phpunit tests -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"require": {
		"php": "^8.1",
		"bamarni/composer-bin-plugin": "^1.8",
		"khanamiryan/qrcode-detector-decoder": "^2.0",
		"onelogin/php-saml": "^4.1",
		"psr/log": "^2.0 || ^3.0",
		"setasign/fpdf": "^1.9",
		"setasign/fpdi": "^2.6",
		"webklex/php-imap": "^6.2"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable30",
		"roave/security-advisories": "dev-latest"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.1"
		}
	}
}
